{
  "permissions": {
    "allow": [
      "Edit(docs/product/specs/*)",
      "Edit(docs/product/specs/*/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session_brief.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/plugin_gap_check.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session_handoff.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(docs/decisions/*)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/adr_immutability_guard.py\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(docs/product/specs/**)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/spec_number_guard.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/secret_leak_guard.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/run_build_test.py\"",
            "timeout": 180,
            "statusMessage": "Running build + tests (deterministic gate)..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/auto_format.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/context_budget_check.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/frontmatter_check.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/claude_md_index_check.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/dependency_audit.py\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(.claude/skills/**)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/skill_index.py\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(.claude/skills/**)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/skill_index.py\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(docs/decisions/*)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/adr_backlink.py\""
          },
          {
            "type": "command",
            "if": "Write(docs/decisions/*)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/decision_index.py\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(docs/decisions/*)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/decision_index.py\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(docs/product/specs/**)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/spec_index.py\""
          },
          {
            "type": "command",
            "if": "Write(docs/product/specs/**)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pipeline_metrics.py\""
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pipeline_metrics.py\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pipeline_metrics.py\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(docs/constitution.md)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/constitution_amendment_check.py\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(docs/constitution.md)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/constitution_amendment_check.py\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(docs/product/specs/**)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/spec_index.py\""
          },
          {
            "type": "command",
            "if": "Edit(docs/product/specs/**)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/spec_status_sync.py\""
          },
          {
            "type": "command",
            "if": "Edit(docs/product/specs/**)",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pipeline_metrics.py\""
          }
        ]
      }
    ]
  }
}
